{# Chrome injected into each LaTeXML-rendered post (nav + footer).
   Rendered as macros so the builder can splice them into the HTML that
   latexmlpost produces. #}

{% macro nav(home_url, site_title, pdf_url, epub_url) -%}
<nav class="blog-nav"><a class="blog-home" href="{{ home_url }}">&larr; {{ site_title }}</a><span class="post-downloads"><a class="post-download" href="{{ pdf_url }}">PDF</a><a class="post-download" href="{{ epub_url }}">ePub</a></span></nav>
{%- endmacro %}

{% macro footer(home_url) -%}
<footer class="blog-footer"><a href="{{ home_url }}">All posts</a></footer>
{%- endmacro %}
