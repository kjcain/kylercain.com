{% extends "base.html.j2" %}
{% from "_macros.html.j2" import post_card, mathjax, sidebar %}

{% block head_extra %}{% if needs_math %}{{ mathjax() }}{% endif %}{% endblock %}
{# `index-page` distinguishes the real index from the tag listings, which also
   carry `blog-index` but have no sidebar column to align the footer against. #}
{% block body_class %}blog-index index-page{% endblock %}

{% block content %}
{# Source order is header, sidebar, posts: that is the reading order when the
   layout collapses to one column. On wide screens the grid moves the sidebar
   into its own column alongside both. #}
<div class="index-layout">
  <header class="blog-header">
    <h1>{{ site_title }}</h1>
    {% if description %}<p class="blog-tagline">{{ description }}</p>{% endif %}
    {% if has_tags %}<p class="blog-taglink"><a href="{{ base }}tags/">Browse tags &rarr;</a></p>{% endif %}
  </header>
{{ sidebar(sidebar_data, base) }}
  <main>
{% for post in posts %}{{ post_card(post, base) }}
{% else %}    <p class="empty">No posts yet. Add a <code>.tex</code> file to <code>posts/</code>.</p>
{% endfor %}  </main>
</div>
{% endblock %}
