{% extends "base.html.j2" %}
{% from "_macros.html.j2" import post_card, mathjax %}

{% block head_extra %}{% if needs_math %}{{ mathjax() }}{% endif %}{% endblock %}
{% block body_class %}blog-index{% endblock %}

{% block content %}
  <header class="blog-header">
    <h1>{{ site_title }}</h1>
    {% if description %}<p class="blog-tagline">{{ description }}</p>{% endif %}
    {% if has_tags %}<p class="blog-taglink"><a href="{{ base }}tags/">Browse tags &rarr;</a></p>{% endif %}
  </header>
  <main>
{% for post in posts %}{{ post_card(post, base) }}
{% else %}    <p class="empty">No posts yet. Add a <code>.tex</code> file to <code>posts/</code>.</p>
{% endfor %}  </main>
{% endblock %}
