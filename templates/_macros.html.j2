{# Reusable fragments shared across the index, tag, and tags pages.
   `base` is the relative path from the current page back to the site root
   (e.g. "" for index.html, "../../" for a post or tag page). #}

{% macro mathjax() -%}
  <script>window.MathJax = { tex: { inlineMath: [['\\(', '\\)']] } };</script>
  <script id="MathJax-script" async
    src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/3.2.2/es5/tex-mml-chtml.min.js"></script>
{%- endmacro %}

{% macro taglist(tags, base) -%}
{%- if tags -%}
<ul class="tag-list">
{%- for t in tags %}<li><a class="tag" href="{{ base }}tags/{{ t.slug }}/">{{ t.name }}</a></li>{% endfor -%}
</ul>
{%- endif -%}
{%- endmacro %}

{# Floating sidebar for the index. Content comes from the "sidebar" object in
   site.json, so links and blurb are edited there, not here. A link URL is used
   as-is when it is absolute (http…, mailto:, #, /) and prefixed with `base`
   otherwise, so internal links like "posts/<slug>/" keep working. #}
{% macro sidebar(data, base) -%}
{%- if data -%}
<aside class="index-sidebar">
{%- if data.heading %}
  <h2 class="sidebar-heading">{{ data.heading }}</h2>
{%- endif %}
{%- if data.blurb %}
  <p class="sidebar-blurb">{{ data.blurb }}</p>
{%- endif %}
{%- if data.links %}
  <ul class="sidebar-links">
{%- for link in data.links %}
{%- set absolute = link.url.startswith(('http://', 'https://', 'mailto:', '#', '/')) %}
    <li><a href="{{ link.url if absolute else base ~ link.url }}">{{ link.label }}</a></li>
{%- endfor %}
  </ul>
{%- endif %}
</aside>
{%- endif -%}
{%- endmacro %}

{% macro post_card(post, base) -%}
    <article class="post-card">
      <h2 class="post-title"><a href="{{ base }}{{ post.url }}">{{ post.title_html|safe }}</a></h2>
      <div class="post-meta">
        {%- if post.date %}<time datetime="{{ post.date }}">{{ post.date }}</time>{% endif -%}
        {%- if post.date and post.author %} &middot; {% endif -%}
        {%- if post.author %}{{ post.author }}{% endif -%}
      </div>
      {%- if post.abstract_html %}
      <p class="post-abstract">{{ post.abstract_html|safe }}</p>
      {%- endif %}
      <p class="post-downloads">
        <a class="post-download" href="{{ base }}{{ post.pdf_url }}">a PDF</a>
        <a class="post-download" href="{{ base }}{{ post.epub_url }}">an ePub</a>
      </p>
      {{ taglist(post.tags, base) }}
    </article>
{%- endmacro %}
